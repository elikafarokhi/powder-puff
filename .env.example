# for local dev: copy this to .env (don't commit it)
# on vercel: add these in Project Settings > Environment Variables

POWDER_THRESHOLD_IN=6
TIMEZONE=America/Toronto

# neon -> your project -> Connect -> pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# any long random string. vercel sends it with the cron request
CRON_SECRET=

# alerts are sent from this gmail. it needs an app password, not your normal one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=

DASHBOARD_URL=https://your-project.vercel.app
